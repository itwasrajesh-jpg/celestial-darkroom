diff --git a/engine/spektra-core/src/main/cpp/tests/test_dodge_burn.cpp b/engine/spektra-core/src/main/cpp/tests/test_dodge_burn.cpp
new file mode 100644
index 0000000..9eb103c
--- /dev/null
+++ b/engine/spektra-core/src/main/cpp/tests/test_dodge_burn.cpp
@@ -0,0 +1,152 @@
+// Dodge & burn light map (spk_params::print_exposure_map) — end to end through spk_simulate.
+//
+//   1. a map of all 1s is byte-identical to no map;
+//   2. a map of all 2s equals doubling the print exposure;
+//   3. a half-and-half map matches each half's own reference away from the seam;
+//   4. the same holds with the enlarger diffusion filter on (the map is applied after it);
+//   5. the print-density memo cannot serve a stale print: map A, map B, then A again;
+//   6. the preview path honours the map too;
+//   7. dodging (0.5) lightens and burning (2) darkens.
+//
+// Usage: test_dodge_burn <asset_dir>
+#include "spektra.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <vector>
+
+static int failures = 0;
+static void check(const char* what, bool ok, const std::string& detail = "") {
+    std::printf("[%s] %s%s\n", what, ok ? "PASS" : "FAIL", detail.empty() ? "" : (" — " + detail).c_str());
+    if (!ok) ++failures;
+}
+
+static const int W = 120, H = 80;
+
+static std::vector<float> make_input() {
+    // A scene with real tonal and colour variation: red rises left to right, blue top to bottom.
+    std::vector<float> rgb(static_cast<size_t>(W) * H * 3);
+    for (int y = 0; y < H; ++y)
+        for (int x = 0; x < W; ++x) {
+            float* p = rgb.data() + (static_cast<size_t>(y) * W + x) * 3;
+            p[0] = 0.02f + 0.50f * x / (W - 1);
+            p[1] = 0.18f;
+            p[2] = 0.05f + 0.40f * y / (H - 1);
+        }
+    return rgb;
+}
+
+static void base_params(spk_params* p) {
+    p->film_profile = "kodak_portra_400";
+    p->print_profile = "kodak_portra_endura";
+    spk_default_params(p);
+}
+
+static std::vector<float> run(spk_engine* eng, std::vector<float>& in, const spk_params& p, bool preview = false) {
+    spk_image img{in.data(), W, H, SPK_CS_PROPHOTO};
+    spk_image out{};
+    spk_status st = preview ? spk_simulate_preview(eng, &img, &p, &out) : spk_simulate(eng, &img, &p, &out);
+    if (st != SPK_OK) { std::printf("simulate failed: %s\n", spk_status_str(st)); ++failures; return {}; }
+    std::vector<float> v(out.data, out.data + static_cast<size_t>(out.width) * out.height * 3);
+    spk_image_free(&out);
+    return v;
+}
+
+static double max_diff(const std::vector<float>& a, const std::vector<float>& b, int x0 = 0, int x1 = W) {
+    if (a.size() != b.size() || a.empty()) return 1e9;
+    const int w = static_cast<int>(a.size() / 3 / H);
+    double m = 0;
+    for (int y = 0; y < H; ++y)
+        for (int x = x0; x < x1 && x < w; ++x)
+            for (int c = 0; c < 3; ++c) {
+                const size_t i = (static_cast<size_t>(y) * w + x) * 3 + c;
+                m = std::fmax(m, std::fabs(static_cast<double>(a[i]) - b[i]));
+            }
+    return m;
+}
+
+static double mean(const std::vector<float>& a) {
+    double s = 0; for (float v : a) s += v; return a.empty() ? 0 : s / a.size();
+}
+
+static std::string fmt(double v) { char b[48]; std::snprintf(b, sizeof b, "%.3e", v); return b; }
+
+int main(int argc, char** argv) {
+    if (argc < 2) { std::printf("usage: test_dodge_burn <asset_dir>\n"); return 2; }
+    spk_engine* eng = nullptr;
+    if (spk_engine_create(argv[1], &eng) != SPK_OK) { std::printf("engine create failed\n"); return 1; }
+    std::vector<float> in = make_input();
+
+    spk_params p{}; base_params(&p);
+    const std::vector<float> plain = run(eng, in, p);
+
+    // 1. all ones == no map, byte for byte
+    std::vector<float> ones(8 * 4, 1.0f);
+    spk_params p1 = p; p1.print_exposure_map = ones.data(); p1.print_exposure_map_w = 8; p1.print_exposure_map_h = 4;
+    const std::vector<float> with_ones = run(eng, in, p1);
+    check("1 map of 1s is byte-identical to no map",
+          with_ones.size() == plain.size() && std::memcmp(with_ones.data(), plain.data(), plain.size() * sizeof(float)) == 0);
+
+    // 2. all twos == print exposure doubled
+    std::vector<float> twos(8 * 4, 2.0f);
+    spk_params p2 = p; p2.print_exposure_map = twos.data(); p2.print_exposure_map_w = 8; p2.print_exposure_map_h = 4;
+    spk_params px2 = p; px2.print_exposure = p.print_exposure * 2.0f;
+    const std::vector<float> map2 = run(eng, in, p2), exp2 = run(eng, in, px2);
+    const double d2 = max_diff(map2, exp2);
+    check("2 map of 2s equals doubling the print exposure", d2 < 1e-5, "max diff " + fmt(d2));
+
+    // 3. half and half: left burned (2), right untouched (1); compare away from the seam
+    std::vector<float> half(8 * 4);
+    for (int y = 0; y < 4; ++y) for (int x = 0; x < 8; ++x) half[y * 8 + x] = x < 4 ? 2.0f : 1.0f;
+    spk_params ph = p; ph.print_exposure_map = half.data(); ph.print_exposure_map_w = 8; ph.print_exposure_map_h = 4;
+    const std::vector<float> halfout = run(eng, in, ph);
+    const double dl = max_diff(halfout, exp2, 0, W / 2 - 16), dr = max_diff(halfout, plain, W / 2 + 16, W);
+    const double seam = max_diff(halfout, plain, W / 2 - 2, W / 2 + 2);
+    check("3 half map: left matches the doubled print", dl < 1e-5, "max diff " + fmt(dl));
+    check("3 half map: right matches the plain print", dr < 1e-5, "max diff " + fmt(dr));
+    check("3 half map: a transition exists at the seam", seam > 1e-4, "change " + fmt(seam));
+
+    // 4. with the enlarger diffusion filter on, the map is applied after it
+    spk_params pd = p;
+    pd.enlarger_diffusion_active = 1; pd.enlarger_diffusion_strength = 1.0f; pd.enlarger_diffusion_spatial_scale = 1.0f;
+    pd.enlarger_diffusion_core_intensity = 0.5f; pd.enlarger_diffusion_core_size = 2.0f;
+    pd.enlarger_diffusion_halo_intensity = 0.5f; pd.enlarger_diffusion_halo_size = 6.0f;
+    spk_params pd2 = pd; pd2.print_exposure_map = twos.data(); pd2.print_exposure_map_w = 8; pd2.print_exposure_map_h = 4;
+    spk_params pdx2 = pd; pdx2.print_exposure = pd.print_exposure * 2.0f;
+    const std::vector<float> dmap = run(eng, in, pd2), dexp = run(eng, in, pdx2), dplain = run(eng, in, pd);
+    const double dd = max_diff(dmap, dexp), dact = max_diff(dplain, plain);
+    check("4 diffusion is actually on in this case", dact > 1e-5, "diffusion changes the print by " + fmt(dact));
+    check("4 with diffusion: map of 2s equals doubled exposure", dd < 1e-4, "max diff " + fmt(dd));
+
+    // 5. the memo must not serve a stale print when only the map changes
+    std::vector<float> mapA(8 * 4, 1.0f), mapB(8 * 4, 1.0f);
+    for (int y = 0; y < 4; ++y) { mapA[y * 8 + 0] = mapA[y * 8 + 1] = 2.0f; mapB[y * 8 + 6] = mapB[y * 8 + 7] = 2.0f; }
+    spk_params pa = p, pb = p;
+    pa.print_exposure_map = mapA.data(); pa.print_exposure_map_w = 8; pa.print_exposure_map_h = 4;
+    pb.print_exposure_map = mapB.data(); pb.print_exposure_map_w = 8; pb.print_exposure_map_h = 4;
+    const std::vector<float> a1 = run(eng, in, pa), b1 = run(eng, in, pb), a2 = run(eng, in, pa);
+    check("5 a different map gives a different print (no stale memo)", max_diff(a1, b1) > 1e-4, "difference " + fmt(max_diff(a1, b1)));
+    check("5 the same map again gives the same print", a1.size() == a2.size() && std::memcmp(a1.data(), a2.data(), a1.size() * sizeof(float)) == 0);
+    // ...and a map's contents changing in place (same pointer, same size) must also be seen
+    mapA[0] = 4.0f;
+    const std::vector<float> a3 = run(eng, in, pa);
+    check("5 the same map edited in place is seen", max_diff(a1, a3) > 1e-5, "difference " + fmt(max_diff(a1, a3)));
+
+    // 6. the preview path honours the map
+    const std::vector<float> pv2 = run(eng, in, p2, true), pvx2 = run(eng, in, px2, true), pvplain = run(eng, in, p, true);
+    check("6 preview: map of 2s equals doubled exposure", !pv2.empty() && max_diff(pv2, pvx2) < 1e-5, "max diff " + fmt(max_diff(pv2, pvx2)));
+    check("6 preview: the map changes the preview", max_diff(pv2, pvplain) > 1e-4);
+
+    // 7. direction: dodge lightens, burn darkens
+    std::vector<float> halves(8 * 4, 0.5f);
+    spk_params pdg = p; pdg.print_exposure_map = halves.data(); pdg.print_exposure_map_w = 8; pdg.print_exposure_map_h = 4;
+    const std::vector<float> dodged = run(eng, in, pdg);
+    check("7 dodge (0.5) makes the print lighter", mean(dodged) > mean(plain), "mean " + fmt(mean(dodged)) + " vs " + fmt(mean(plain)));
+    check("7 burn (2) makes the print darker", mean(map2) < mean(plain), "mean " + fmt(mean(map2)) + " vs " + fmt(mean(plain)));
+
+    spk_engine_destroy(eng);
+    std::printf(failures ? "SOME FAILED (%d)\n" : "ALL PASS\n", failures);
+    return failures ? 1 : 0;
+}
