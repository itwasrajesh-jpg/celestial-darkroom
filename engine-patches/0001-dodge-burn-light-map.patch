+// Dodge & burn: the light map's value at pixel p of a width×height render, sampled bilinearly at
+// the pixel's centre so the map can be any size. Never negative.
+static inline double exposure_map_at(const PrintingParams& pp, int p, int width, int height) {
+    const int mw = pp.exposure_map_w, mh = pp.exposure_map_h;
+    const int x = p % width, y = p / width;
+    double u = (x + 0.5) * mw / static_cast<double>(width) - 0.5;
+    double v = (y + 0.5) * mh / static_cast<double>(height) - 0.5;
+    u = std::fmin(std::fmax(u, 0.0), static_cast<double>(mw - 1));
+    v = std::fmin(std::fmax(v, 0.0), static_cast<double>(mh - 1));
+    const int x0 = static_cast<int>(u), y0 = static_cast<int>(v);
+    const int x1 = x0 + 1 < mw ? x0 + 1 : mw - 1, y1 = y0 + 1 < mh ? y0 + 1 : mh - 1;
+    const double fx = u - x0, fy = v - y0;
+    const float* m = pp.exposure_map;
+    const double top = m[y0 * mw + x0] * (1.0 - fx) + m[y0 * mw + x1] * fx;
+    const double bot = m[y1 * mw + x0] * (1.0 - fx) + m[y1 * mw + x1] * fx;
+    return std::fmax(top * (1.0 - fy) + bot * fy, 0.0);
+}
