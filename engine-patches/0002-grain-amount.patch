--- a/engine/spektra-core/src/main/cpp/spektra.h
+++ b/engine/spektra-core/src/main/cpp/spektra.h
@@ -350,6 +350,12 @@ typedef struct {
     const float* print_exposure_map;
     int32_t print_exposure_map_w;
     int32_t print_exposure_map_h;
+    /* Grain amount (Latent): how strong the film's grain is, 0 none … 1 the model's own … more is
+     * stronger. Read only when grain_amount_set is non-zero, so a zeroed struct keeps the model's
+     * own grain; 1 leaves every render byte-identical. The viewing glare that grain_active also
+     * turns on is not affected. */
+    int32_t grain_amount_set;
+    float grain_amount;
 } spk_params;
 
 /* Initialise `p` to the physical defaults that mirror a default-constructed
