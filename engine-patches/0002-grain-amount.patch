 .../src/main/cpp/runtime/stages/filming.cpp   |  14 +-
 engine/spektra-core/src/main/cpp/spektra.cpp  |   4 +
 engine/spektra-core/src/main/cpp/spektra.h    |   6 +
 .../spektra-core/src/main/cpp/spektra_jni.cpp |   8 ++
 .../src/main/cpp/tests/test_grain_amount.cpp  | 131 ++++++++++++++++++
 .../com/spectrafilm/engine/SpektraParams.kt   |   2 +
 7 files changed, 168 insertions(+), 1 deletion(-)
 create mode 100644 engine/spektra-core/src/main/cpp/tests/test_grain_amount.cpp

diff --git a/engine/spektra-core/src/main/cpp/model/grain.h b/engine/spektra-core/src/main/cpp/model/grain.h
index ae84639..467272b 100644
--- a/engine/spektra-core/src/main/cpp/model/grain.h
+++ b/engine/spektra-core/src/main/cpp/model/grain.h
@@ -60,6 +60,10 @@ struct GrainParams {
     // A single global offset is added so independent realisations can be drawn.
     int seed_base[3] = {0, 1, 2};
     int seed_offset = 0;
+    // Grain amount (Latent): the developed density is clean + amount * (grainy - clean).
+    // 1 (the default) is the model's own grain and skips the blend entirely (byte-identical);
+    // 0 is no grain at all; above 1 stronger. Not part of spektrafilm's schema.
+    double amount = 1.0;
 };
 
 // layer_particle_model(density, density_max, n_particles_per_pixel,
diff --git a/engine/spektra-core/src/main/cpp/runtime/stages/filming.cpp b/engine/spektra-core/src/main/cpp/runtime/stages/filming.cpp
index 29cd4e4..72631dc 100644
--- a/engine/spektra-core/src/main/cpp/runtime/stages/filming.cpp
+++ b/engine/spektra-core/src/main/cpp/runtime/stages/filming.cpp
@@ -633,7 +633,12 @@ void develop(const float* log_raw, int width, int height, const Profile& film,
     // digest_grain_params when grain_active && stochastic effects are on). The
     // model operates on the post-coupler density_cmy, mirroring emulsion.py::
     // develop, which calls apply_grain after apply_density_correction_dir_couplers.
-    if (params.grain.active) {
+    // Grain amount (Latent): 0 is no grain; anything but 1 keeps the clean density to blend with.
+    const double grain_amount = params.grain.amount;
+    std::vector<float> clean_density;
+    if (params.grain.active && grain_amount > 0.0 && grain_amount != 1.0)
+        clean_density.assign(density_cmy_out, density_cmy_out + static_cast<size_t>(npix) * 3);
+    if (params.grain.active && grain_amount > 0.0) {
         ScopedStage _t(STG_GRAIN);
         GrainParams grain = params.grain;
         // The sublayer path is selected when sublayers_active AND the profile
@@ -685,6 +690,13 @@ void develop(const float* log_raw, int width, int height, const Profile& film,
             apply_grain_to_density(density_cmy_out, npix, width, height,
                                    params.pixel_size_um, grain, density_cmy_out);
         }
+        // clean + amount * (grainy - clean), place by place (no threads: the same bytes for any count)
+        if (!clean_density.empty()) {
+            const float a = static_cast<float>(grain_amount);
+            const size_t n3 = static_cast<size_t>(npix) * 3;
+            for (size_t i = 0; i < n3; ++i)
+                density_cmy_out[i] = clean_density[i] + a * (density_cmy_out[i] - clean_density[i]);
+        }
     }
 }
 
diff --git a/engine/spektra-core/src/main/cpp/spektra.cpp b/engine/spektra-core/src/main/cpp/spektra.cpp
index ead4bd4..19cfbd0 100644
--- a/engine/spektra-core/src/main/cpp/spektra.cpp
+++ b/engine/spektra-core/src/main/cpp/spektra.cpp
@@ -780,6 +780,10 @@ void apply_user_grain(spk::GrainParams& g, const spk_params* p) {
     g.micro_structure[0] = p->grain_micro_structure[0];
     g.micro_structure[1] = p->grain_micro_structure[1];
     g.n_sub_layers = p->grain_n_sub_layers > 0 ? p->grain_n_sub_layers : 1;
+    // Latent's grain amount; unset (or not a number) is the model's own grain.
+    g.amount = (p->grain_amount_set != 0 && p->grain_amount == p->grain_amount)
+                   ? (p->grain_amount > 0.0f ? static_cast<double>(p->grain_amount) : 0.0)
+                   : 1.0;
 }
 
