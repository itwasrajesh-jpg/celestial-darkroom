<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets Latent install its own updates from inside the app. Android still asks once for
         permission and shows its confirmation; later updates may need no tap on Android 12+. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="false"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Latent">
        <!-- 88b: the app's one screen. The launcher reaches it through one of the icons below. -->
        <activity
            android:name=".CameraActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Latent" />
        <!-- 88b: one launcher icon per theme (AppIcon.kt enables the chosen one). The Darkroom one keeps the
             old ".MainActivity" name, so home-screen icons made before this update keep working. -->
        <activity-alias
            android:name=".MainActivity"
            android:targetActivity=".CameraActivity"
            android:icon="@mipmap/ic_launcher"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconMidnight"
            android:targetActivity=".CameraActivity"
            android:icon="@mipmap/ic_launcher_midnight"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconClay"
            android:targetActivity=".CameraActivity"
            android:icon="@mipmap/ic_launcher_clay"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Android's installer reports here on an update; only Latent itself can reach it. -->
        <receiver
            android:name=".UpdateInstallReceiver"
            android:exported="false" />
    </application>
</manifest>
